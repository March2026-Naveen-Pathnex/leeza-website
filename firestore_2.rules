rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /orders/{orderId} {
      // Customers (not logged in) can CREATE an order — but only with
      // reasonable data, and they can never read, edit, or delete orders
      // (including other people's orders) once placed.
      allow create: if request.resource.data.total is number
                    && request.resource.data.total >= 0
                    && request.resource.data.total < 100000
                    && request.resource.data.items is list
                    && request.resource.data.status is string;

      // Only signed-in admins (you) can view or manage orders.
      allow read, update, delete: if request.auth != null;
    }

    match /menu/{itemId} {
      // Anyone can read the menu (it's a public website).
      allow read: if true;
      // Only you (signed in) can add, edit, or remove flavors.
      allow write: if request.auth != null;
    }
  }
}
